    "@autobi/contracts": "workspace:*",
    "@autobi/database": "workspace:*",
    "@autobi/dashboard-engine": "workspace:*",
    "@autobi/query-engine": "workspace:*",
    "@autobi/semantic-engine": "workspace:*",
    "@autobi/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
