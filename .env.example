# --- Host ports (Docker publishes these; avoid 3000/3001/5432/6379) ---
WEB_HOST_PORT=3100
API_HOST_PORT=3101
MAILPIT_UI_PORT=8025

POSTGRES_USER=autobi
POSTGRES_PASSWORD=autobi
POSTGRES_DB=autobi
REDIS_PASSWORD=autobi

# App DB — Compose services use host `postgres` (injected). For local pnpm + publish-data:
#   docker compose --profile publish-data up -d postgres redis mailpit postgres-host redis-host
DATABASE_URL=postgresql://autobi:autobi@localhost:5434/autobi?schema=public

# Redis — Compose injects redis://:pass@redis:6379. Local pnpm + publish-data:
REDIS_URL=redis://:autobi@localhost:6380

# 32-byte hex key for AES-256-GCM (generate: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session signing secret
SESSION_SECRET=change-me-to-a-long-random-string

# Nest listen port (local pnpm). Containers force 3001 internally.
API_PORT=3101
API_CORS_ORIGIN=http://localhost:3100
# APP_PUBLIC_URL=http://localhost:3100
NODE_ENV=development

# TRUST_PROXY=true
# COOKIE_DOMAIN=

# SMTP — Compose defaults to Mailpit (smtp://mailpit:1025). Required when NODE_ENV=production.
SMTP_URL=smtp://localhost:1025
# SMTP_FROM=AutoBI <noreply@example.com>

# DB_HOST_ALLOW_PRIVATE=true
# ALLOW_PUBLIC_REGISTRATION=true

# LOG_LEVEL=info
# SENTRY_DSN=

NEXT_PUBLIC_API_URL=http://localhost:3101

# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
