# AutoBI internal PostgreSQL
DATABASE_URL=postgresql://autobi:autobi@localhost:5432/autobi?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# 32-byte hex key for AES-256-GCM (generate: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session signing secret
SESSION_SECRET=change-me-to-a-long-random-string

# API
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional defaults (workspace configs preferred)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
